{
  "name": "troll-vs-elves",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "typecheck": "pnpm --filter @troll-vs-elves/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . && prettier --check .",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "dev:server": "pnpm --filter @troll-vs-elves/shared build && pnpm --filter @troll-vs-elves/server build && pnpm --filter @troll-vs-elves/server start",
    "dev:client": "pnpm --filter @troll-vs-elves/shared build && pnpm --filter @troll-vs-elves/client dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
